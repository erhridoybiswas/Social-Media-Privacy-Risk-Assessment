# Copy this file to ".env" and adjust values locally.
# The application runs fine with defaults if .env is absent.

# Path to the SQLite database file
PRIVACY_DB_PATH=data/privacy_assessment.db

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# Simple in-memory rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# When true, assessments are NOT written to the database at all
PRIVACY_NO_PERSIST=0